rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /user_diaries/{uid} {
      allow read, write: if owns(uid);

      match /jurnals/{journalId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120;

        match /notebooks/{pageId} {
          allow read, delete: if owns(uid);
          allow create, update: if owns(uid)
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 100000;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
